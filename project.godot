; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Plonki-Deluxe"
run/main_scene="uid://duilo8mjxt5la"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=144
config/icon="uid://cy1q20a3g3tnb"

[autoload]

SignalBus="*uid://djee380ynnny2"
SaveManager="*uid://d03l27pfkh31u"
BallFactoryManager="*uid://btanyn2b3wtwh"
GlobalVars="*uid://cwoxp4vyoq74f"
CsCalculator="*uid://b4jekncudnine"
MoneyTextShortener="*uid://oy8lc1yo4l08"

[display]

window/size/viewport_height=864
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://2D/": "green",
"res://custom_res/": "purple",
"res://scenes/": "yellow",
"res://scripts/": "blue",
"res://sounds/": "orange"
}

[global_group]

ball_kill=""

[gui]

timers/tooltip_delay_sec=0.2

[input]

fire_ball={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
send_console_command={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

2d/run_on_separate_thread=true
2d/physics_engine="GodotPhysics2D"
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
